<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Ligne nom + icône bateau -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:text="🚢"
            android:textSize="22sp"
            android:layout_marginEnd="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtNomNavire"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- Fret -->
    <TextView
        android:id="@+id/txtFret"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="32dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Statut (En escale / En attente) -->
    <TextView
        android:id="@+id/txtEnEscale"
        android:text="⚓ En escale"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/bg_status_escale"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Bouton demande d'escale -->
    <Button
        android:id="@+id/btnDemanderEscale"
        android:text="Demander une escale"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:textSize="13sp"
        android:background="@drawable/bg_button_primary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:minHeight="0dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="32dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="40dp"/>

</LinearLayout>