<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Image de fond zoomée pour remplir tout l'écran -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fond_rochelle"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- Overlay dégradé sombre par-dessus -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient" />

    <!-- Le ScrollView vient APRÈS pour passer au-dessus -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <!-- Logo ⚓ -->
            <TextView
                android:text="⚓"
                android:textSize="60sp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Titre -->
            <TextView
                android:text="PORT DE LA ROCHELLE"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:layout_marginBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Espace armateur"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:letterSpacing="0.05"
                android:layout_marginBottom="40dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Carte glass de connexion -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:background="@drawable/bg_glass_card">

                <TextView
                    android:text="Connexion"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <EditText
                    android:id="@+id/editLogin"
                    android:hint="Identifiant"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/white"
                    android:inputType="text"
                    android:background="@drawable/bg_edittext"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"/>

                <EditText
                    android:id="@+id/editMdp"
                    android:hint="Mot de passe"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/white"
                    android:inputType="textPassword"
                    android:background="@drawable/bg_edittext"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"/>

                <Button
                    android:id="@+id/btnConnexion"
                    android:text="Se connecter"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:background="@drawable/bg_button_primary"
                    android:padding="14dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtErreur"
                    android:textColor="#FFB3BA"
                    android:textSize="13sp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>